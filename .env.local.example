# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 管理者パスコード（スタンプポイント 1〜5 それぞれ別のパスコード）
ADMIN_PASS_1=your-passcode-1
ADMIN_PASS_2=your-passcode-2
ADMIN_PASS_3=your-passcode-3
ADMIN_PASS_4=your-passcode-4
ADMIN_PASS_5=your-passcode-5

# 管理者セッション署名シークレット（32文字以上のランダム文字列）
ADMIN_SESSION_SECRET=your-session-secret-32chars-or-more
